# Supabase project — both values are safe to expose to the browser.
# The publishable (anon) key can only call the potluck_* RPC functions defined
# in supabase/migrations; every table is RLS deny-all in a private schema.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# RPC function-name prefix, prepended to every call (default: potluck_).
# The canonical migration namespaces the whole API as potluck_* so the same
# SQL works in a dedicated project or colocated inside a shared one.
# Only override if you rename the functions.
#VITE_RPC_PREFIX=potluck_
