# Supabase project — both values are safe to expose to the browser.
# The anon key can only call the RPC functions defined in supabase/migrations;
# tables are RLS deny-all.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# RPC function-name prefix. Leave empty (or unset) for a dedicated Supabase
# project running supabase/migrations/0001_potluck.sql. Set to `potluck_` when
# the backend is colocated inside a shared project via
# supabase/colocation/potluck_in_shared_project.sql.
VITE_RPC_PREFIX=
